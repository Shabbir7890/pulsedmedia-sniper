# Copy this file to .env and fill it in. Never share or commit .env.

# Session cookie from a browser on THIS machine (see README: Getting your session cookie)
PM_COOKIE=WHMCSmNqPBCNDcH8d=paste-your-value-here

# Username of a Pulsed Media box you already own, if any. It is always treated
# as taken, so it is never reused for a new order. Leave empty if you own none.
PM_USERNAME=

# Telegram control and alerts (strongly recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# true = never places an order. Set false (or /arm in Telegram) when ready.
PM_DRY_RUN=true
PM_MODE=auto

# Seconds between stock checks (minimum 10) and random extra delay
PM_POLL_SECONDS=20
PM_JITTER_SECONDS=5
PM_KEEPALIVE_SECONDS=300

# First-run target only. After the first start, choose products with /setup or
# /watch in Telegram instead. If you change PM_PID, set PM_PRODUCT_NAME to that
# product's exact store name, or the bot disables the target as a safety check.
PM_PID=355
# PM_PRODUCT_NAME=<exact store name of PM_PID>   (default: the 8TB R5 10G seedbox, pid 355)
PM_TARGET_TOTAL=1
PM_BILLING_CYCLE=monthly
PM_MAX_TOTAL=12
